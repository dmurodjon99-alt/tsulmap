# ---------------------------------------------------------------------------
# Конфигурация Apache для статического хостинга (Plesk / eskiz.uz).
# Файл кладётся в корень сайта вместе со сборкой (httpdocs/.htaccess).
# ---------------------------------------------------------------------------

# 1. SPA-fallback: приложение одностраничное, маршруты обрабатывает роутер.
#    Без этого прямая ссылка вида /building/building-1 вернёт 404.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Существующие файлы и каталоги отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — на index.html
  RewriteRule . /index.html [L]
</IfModule>

# 2. Кеширование. Имена файлов в assets/ содержат хеш содержимого,
#    поэтому их можно кешировать надолго; index.html — никогда.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# 3. Сжатие текстовых ресурсов (видео и картинки сжимать не нужно).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. MIME-типы: некоторые сборки Apache не знают про современные форматы.
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
</IfModule>

# 5. Отдача видео по частям — чтобы браузер мог перематывать и не тянул
#    все 9,5 МБ одним куском.
<IfModule mod_headers.c>
  <FilesMatch "\.mp4$">
    Header set Accept-Ranges bytes
  </FilesMatch>
</IfModule>
